{
  "builds": [
    {
      "src": "api/dashboard.py",
      "use": "@vercel/python"
    },
    {
      "src": "api/sync-garmin.py",
      "use": "@vercel/python"
    },
    {
      "src": "api/sync-strava.py",
      "use": "@vercel/python"
    },
    {
      "src": "api/calculate.py",
      "use": "@vercel/python"
    },
    {
      "src": "api/widget.py",
      "use": "@vercel/python"
    },
    {
      "src": "api/activity.py",
      "use": "@vercel/python"
    },
    {
      "src": "api/day.py",
      "use": "@vercel/python"
    },
    {
      "src": "api/coach.py",
      "use": "@vercel/python",
      "config": {
        "maxDuration": 60,
        "memory": 1024
      }
    },
    {
      "src": "api/sync-all.py",
      "use": "@vercel/python",
      "config": {
        "maxDuration": 60,
        "memory": 1024
      }
    },
    {
      "src": "api/history.py",
      "use": "@vercel/python"
    },
    {
      "src": "api/plan.py",
      "use": "@vercel/python",
      "config": {
        "maxDuration": 60
      }
    },
    {
      "src": "api/login.py",
      "use": "@vercel/python"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/sync-garmin",
      "dest": "/api/sync-garmin.py"
    },
    {
      "src": "/api/sync-strava",
      "dest": "/api/sync-strava.py"
    },
    {
      "src": "/api/calculate",
      "dest": "/api/calculate.py"
    },
    {
      "src": "/api/dashboard",
      "dest": "/api/dashboard.py"
    },
    {
      "src": "/api/widget",
      "dest": "/api/widget.py"
    },
    {
      "src": "/api/coach",
      "dest": "/api/coach.py"
    },
    {
      "src": "/api/activity(.*)",
      "dest": "/api/activity.py"
    },
    {
      "src": "/api/day(.*)",
      "dest": "/api/day.py"
    },
    {
      "src": "/api/sync-all",
      "dest": "/api/sync-all.py"
    },
    {
      "src": "/api/history(.*)",
      "dest": "/api/history.py"
    },
    {
      "src": "/api/plan(.*)",
      "dest": "/api/plan.py"
    },
    {
      "src": "/api/login",
      "dest": "/api/login.py"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ],
  "crons": [
    {
      "path": "/api/sync-all",
      "schedule": "10 5 * * *"
    }
  ]
}
